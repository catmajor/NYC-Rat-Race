{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm ci && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://nyc-rat-race-bay.vercel.app/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://nyc-rat-race-bay.vercel.app/health"
    }
  ]
}

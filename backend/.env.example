# Shared language-model configuration for all adviser rats.
# Get a free Gemini API key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.8
GEMINI_TIMEOUT_SECONDS=20

# Optional real TLC source configuration.
RAT_RACE_TLC_GLOB=data/tlc_nyc/yellow/yellow_tripdata_*.parquet
RAT_RACE_TLC_ZONE_MAP=data/tlc_nyc/taxi_zone_game_map.csv
RAT_RACE_TLC_START_DATE=2019-10-01
RAT_RACE_TLC_END_DATE=2019-10-31
RAT_RACE_NOAA_GLOB=data/noaa_isd_nyc/*.csv
RAT_RACE_GDELT_GLOB=data/gdelt_nyc/events/gdelt_events_nyc_*.parquet